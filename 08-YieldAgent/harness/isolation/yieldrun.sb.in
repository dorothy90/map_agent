(version 1)
(deny default)
(allow process*)
(allow sysctl-read)
(allow file-read* (subpath "/System") (subpath "/usr") (subpath "/bin") (subpath "/Library") (subpath "@VENV@"))
(allow file-read-metadata
  (literal "/")
  (literal "/var")
  (literal "/var/lib")
  (literal "@HOME@")
  (literal "@WORK_ROOT@")
  (literal (param "PROFILE"))
  (literal (param "WORKDIR")))
(allow file-read* file-write* (subpath (param "PROFILE")) (subpath (param "WORKDIR")))
(deny network*)
