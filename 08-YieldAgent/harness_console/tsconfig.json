    "src/hermes/app/session/hooks/profile-rail-fresh-chat-owner.test.tsx",
    "src/hermes/app/session/hooks/use-prompt-actions/prepared-submissions-spent.test.ts",
    "src/hermes/components/assistant-ui/catalog-install-tool.test.tsx",
    "src/hermes/components/assistant-ui/connector-directory-card.test.tsx",
    "src/hermes/components/assistant-ui/connector-tool.test.tsx",
    "src/hermes/components/assistant-ui/mcp-setup-tool.test.tsx",
    "src/hermes/components/assistant-ui/thread/message-parts-connectors.test.tsx",
