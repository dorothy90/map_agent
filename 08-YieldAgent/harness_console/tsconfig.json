{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node",
      "vitest/globals"
    ],
    "paths": {
      "@hermes/shared": [
        "./src/protocol/pr9-full.ts"
      ],
      "@/*": [
        "./src/hermes/*"
      ],
      "@hermes/shared/i18n": [
        "./src/protocol/i18n.ts"
      ],
      "@hermes/shared/ansi": [
        "./src/protocol/pr9-ansi.ts"
      ],
      "@hermes/shared/color": [
        "./src/protocol/pr9-extra/color.ts"
      ],
      "@hermes/shared/skin": [
        "./src/protocol/pr9-extra/skin.ts"
      ],
      "@hermes/shared/translucency": [
        "./src/protocol/pr9-extra/translucency.ts"
      ],
      "@hermes/shared/billing": [
        "./src/protocol/pr9-extra/billing-types.ts"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ],
  "exclude": [
    "src/hermes/app/capabilities/connectors/data/queries-rules.test.tsx",
    "src/hermes/app/chat/composer/discard-lost-prompt.test.ts",
    "src/hermes/app/chat/composer/hooks/use-at-completions-contrib.test.tsx",
    "src/hermes/app/chat/composer/hooks/use-completions-owner-route.test.tsx",
    "src/hermes/app/chat/composer/hooks/use-composer-voice-shortcuts.test.tsx",
    "src/hermes/app/chat/composer/hooks/use-composer-voice.test.tsx",
    "src/hermes/app/chat/composer/hooks/use-slash-completions.test.tsx",
    "src/hermes/app/chat/composer/status-stack/coding-row.test.tsx",
    "src/hermes/app/chat/new-session-drag.test.ts",
    "src/hermes/app/chat/right-rail/preview-popout-bridge.test.ts",
    "src/hermes/app/chat/session-drag.test.ts",
    "src/hermes/app/chat/sidebar/cron-jobs-section.test.tsx",
    "src/hermes/app/chat/sidebar/gateway-groups-drag.test.tsx",
    "src/hermes/app/chat/sidebar/gateway-groups.test.tsx",
    "src/hermes/app/chat/sidebar/profile-launch-menu.test.tsx",
    "src/hermes/app/chat/sidebar/project-dialog.test.tsx",
    "src/hermes/app/hud/composer-drag.test.ts",
