OPENAI_API_KEY=
ANTHROPIC_API_KEY=

LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=LangGraph-Tutorial

TAVILY_API_KEY=

# Goal-driven harness: opt in new sessions after the live release checks.
HARNESS_ENABLED=false
HARNESS_ENGINE=hermes
HARNESS_MODEL=z-ai/glm-5.3-flash
HARNESS_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Lowercase groq_api_key is also accepted. Optional override for custom endpoints:
HARNESS_API_KEY=
HARNESS_MONGO_URI=mongodb://localhost:27017
HARNESS_MONGO_DB=yield_agent
HARNESS_PRINCIPAL=local
HARNESS_TOOL_LIMIT=24
HARNESS_MODEL_LIMIT=40
HARNESS_TOKEN_LIMIT=120000
HARNESS_CONTEXT_TOKENS=24000
HARNESS_ACTIVE_SECONDS=300
HARNESS_CALL_TIMEOUT=90
HARNESS_MAX_OUTPUT_TOKENS=8192
HARNESS_ANSWER_OUTPUT_TOKENS=4096
HARNESS_REVIEW_OUTPUT_TOKENS=2048
HARNESS_EVIDENCE_TOKENS=2000
HARNESS_TEMPERATURE=1.0
HARNESS_REASONING_EFFORT=high
HARNESS_PYTHON_IMAGE=yield-harness-python:2
HARNESS_MINING_API_URL=

ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=
ORACLE_CALL_TIMEOUT_MS=30000
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=
OPENSEARCH_USE_SSL=false
OPENSEARCH_INDEX=fail-history
