# Non-secret production settings
ENVIRONMENT=production
MONGO_DB=yield_agent
ARTIFACT_ROOT=/mnt/yield-agent
PLATFORM_USER_ID_HEADER=user_id
CORS_ORIGINS=["https://yield-agent.example.internal"]
USER_JOB_LIMIT=2
GLOBAL_JOB_LIMIT=100
WORKER_LEASE_SECONDS=60
RECONCILE_INTERVAL_SECONDS=60
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=4
ORACLE_POOL_INCREMENT=1
ENABLE_LEGACY_CHAT=false
ENABLE_REPL=false
ENABLE_WIKI=false
ENABLE_LOCAL_TRACE=false
LOG_LEVEL=INFO

# Platform Secrets: inject values at runtime; never commit real credentials.
MONGO_URI=
REDIS_URL=
OWNER_HASH_KEY=
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=
OPENROUTER_BASE_URL=
OPENROUTER_API_KEY=

# Optional observability integration
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
